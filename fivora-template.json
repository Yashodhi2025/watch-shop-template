      "cart.title",
      "cart.emptyTitle",
      "cart.emptyDescription",
      "cart.summaryTitle",
      "cart.itemsLabel",
      "cart.subtotalLabel",
      "cart.note",
      "cart.checkoutNote",
      "cart.continueLabel",
      "cart.continueUrl",
      "cart.removeLabel",
      "cart.addLabel",
      "cart.addedLabel"
