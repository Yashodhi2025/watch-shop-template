      "home.collectionCta",
      "home.emailPlaceholder",
      "home.enquireLabel",
      "home.newsletterSuccess",
      "home.products[*].id",
      "home.products[*].addedAt",
      "home.products[*].featuredOrder",
      "home.arrivals[*].id",
      "home.arrivals[*].addedAt",
      "home.arrivals[*].featuredOrder",
      "collectionsPage.imageAlt",
      "shop.emptyTitle",
      "shop.emptyDescription",
      "shop.selectedLabel",
      "shop.selectionNote",
      "shop.actionLabel",
      "collectionsPage.collectionCta",
      "collectionsPage.countLabel",
      "home.collections[*].shopHref",
      "home.products[*].gallery[*].imageAlt",
      "home.arrivals[*].gallery[*].imageAlt",
      "productDetails.pageTitle",
      "productDetails.specificationsEmpty",
      "productDetails.relatedEmpty",
      "productDetails.enquiryTitle",
      "productDetails.enquiryDescription",
      "productDetails.enquiryMessage",
      "productDetails.emailLabel",
      "productDetails.whatsappLabel",
      "productDetails.enquiryDemo",
      "productDetails.closeEnquiryLabel",
      "productDetails.loadingTitle",
      "productDetails.missingTitle",
      "productDetails.missingDescription",
      "productDetails.previousLabel",
      "productDetails.nextLabel",
      "common.routingCta",
      "common.routingLabel",
      "common.routingNote",
      "productDetails.eyebrow",
      "productDetails.referenceLabel",
      "productDetails.primaryImageLabel",
      "productDetails.zoomLabel",
      "productDetails.priceNote",
      "productDetails.enquireLabel",
      "productDetails.enquiryNote",
      "productDetails.serviceTitle",
      "productDetails.serviceDescription",
      "productDetails.discoverLabel",
      "productDetails.descriptionTitle",
      "productDetails.specificationsTitle",
      "productDetails.demoNote",
      "productDetails.relatedEyebrow",
