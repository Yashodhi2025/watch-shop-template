  "siteDataFile": "src/data/site-data.json",
  "outputDirectory": "out",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "basePathEnvVar": "NEXT_PUBLIC_SITE_BASE_PATH",
  "pages": [
    {
      "id": "home",
      "label": "AUREL — Luxury Watch Boutique",
      "route": "/",
      "required": true,
      "description": "Luxury watch storefront homepage: curated watches, collections and brand story."
    },
    {
      "id": "shop",
      "label": "Shop",
      "route": "/shop",
      "required": true,
      "description": "Search, filter and sort the shared AUREL catalog."
    },
    {
      "id": "collections",
      "label": "Collections",
      "route": "/collections",
      "required": true,
      "description": "Editorial collection stories linking to the filtered Shop."
    },
    {
      "id": "product_link",
      "label": "Watch Details",
      "route": "/products/detail",
      "required": true,
      "description": "Luxury timepiece details, editable gallery and specifications, concierge enquiry, and related watches. Stable client-side ID routing."
    },
    {
      "id": "cart",
      "label": "Shopping Cart",
      "route": "/cart",
      "required": true
    }
  ],
